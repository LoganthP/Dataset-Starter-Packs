# Copy to .env (optional). All values have sensible defaults.
DSP_MAX_PARALLEL_RUNS=2
DSP_RUN_TIMEOUT_SECONDS=900
DSP_MAX_UPLOAD_MB=200
# Set to your GitHub repo to show "Open on GitHub" links, e.g. LoganthP/dataset-starter-packs
DSP_GITHUB_REPO=
DSP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Discovery imports (UCI, Kaggle, NASA CMR). 0 = only when you click "Refresh imports" on the Sources page.
DSP_IMPORT_INTERVAL_HOURS=0
DSP_ADAPTER_TIMEOUT_SECONDS=20
# Optional Kaggle credentials for the search adapter (kept server-side). ~/.kaggle/kaggle.json also works.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Live search (Discover asks these on every new query; results are cached per query) ----
# Web search for dataset landing pages: set ONE of these. Without a key the "Web search" source shows "not configured".
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Optional Hugging Face token (higher rate limits, access to gated cards you've accepted)
HF_TOKEN=
DSP_LIVE_CACHE_HOURS=6
# Largest file "Import" will download or accept as an upload
DSP_MAX_TRANSFER_BYTES=2000000000
DSP_MAX_EXTRACT_BYTES=6000000000
# Files with more rows than this are analyzed on a seeded reservoir sample of DSP_ANALYSIS_SAMPLE_ROWS rows.
DSP_ANALYSIS_SAMPLE_OVER_ROWS=1000000
DSP_ANALYSIS_SAMPLE_ROWS=200000

# ---- Durable storage (optional locally). Unset = SQLite in DSP_STATE_DIR.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# BLOB_READ_WRITE_TOKEN=   (Vercel Blob: direct uploads for large files)
