      "expect_group": {"socrata-nyc.h9gi-nx95": "needs-verification", "socrata-chicago.85ca-t3if": "meets"},
      "never_meets": ["uci.492", "nasa-power.daily-point", "uci.275"]
    },
    {
      "id": "traffic-latlon",
      "q": "Traffic incidents with latitude, longitude, and timestamps",
      "expect_top5": ["socrata-nyc.h9gi-nx95", "socrata-chicago.85ca-t3if", "dft.road-safety-collisions", "kaggle.sobhanmoosavi-us-accidents"],
      "expect_group": {"uci.492": "does-not-meet"},
      "never_meets": ["uci.492", "nasa-power.daily-point", "open-meteo.historical-weather"]
    },
    {
      "id": "bengaluru-weather",
