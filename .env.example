# Copy to .env next to compose.yaml (Docker) or set these in Vercel → Project → Settings → Environment Variables.
# Every value is optional. Never commit .env.

# ---- Durable storage
# Unset: SQLite in DSP_STATE_DIR (Docker keeps it on the dsp-data volume).
# Set to a Postgres URL to store analyses, comparisons and curated records there (required on Vercel; Neon from the Marketplace sets it).
DATABASE_URL=
# Vercel Blob read-write token: enables direct browser-to-Blob uploads, so large files skip the function request body.
# Set automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# ---- Live search providers (server-side only)
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
HF_TOKEN=
# Kaggle server credentials (optional fallback). Users normally connect their own account in Settings → Kaggle.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Kaggle OAuth (only with a client registered with Kaggle): enables "Sign in with Kaggle".
KAGGLE_OAUTH_CLIENT_ID=
KAGGLE_OAUTH_CLIENT_SECRET=
KAGGLE_OAUTH_SCOPE=datasets.get:*
# Public URL of this app, used for the OAuth redirect (…/api/kaggle/oauth/callback)
DSP_PUBLIC_URL=

# ---- Accounts and secrets
# Fernet key that encrypts connected-provider credentials. Required on Vercel / multi-instance deployments.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset locally/Docker: generated once into DSP_STATE_DIR/secret.key (on the volume).
DSP_SECRET_KEY=

# ---- Limits (bytes are decimal: 2 GB = 2,000,000,000)
# Uploads and provider downloads, ZIPs included (UI, API, Blob upload tokens and workers all use this)
DSP_MAX_TRANSFER_BYTES=2000000000
# Bytes written when expanding archives for one run, measured while extracting (not from the archive's own claims)
DSP_MAX_EXTRACT_BYTES=6000000000
DSP_MAX_ARCHIVE_MEMBERS=250000
# Temporary download failures are retried (resuming with HTTP Range when the server allows it)
DSP_DOWNLOAD_RETRIES=2
# Analyze sample (the default action): first N rows, finished within the deadline
DSP_QUICK_SAMPLE_ROWS=1000
DSP_SAMPLE_DEADLINE_SECONDS=60
# Parquet/ZIP/Excel have to be read whole even for a sample; larger ones offer "Prepare archive and run sample" or Full analysis
DSP_SAMPLE_MAX_MB=25
# Download cache shared by Look inside, samples and reruns (keyed by URL, version and ETag; per user for Kaggle)
# DSP_CACHE=0 turns the cache off
DSP_CACHE=1
DSP_CACHE_MAX_BYTES=5000000000
# Remote ZIPs: read just the needed members with HTTP ranges when they are a small share of a large archive
DSP_RANGE_FETCH_MAX_SHARE=0.5
DSP_RANGE_MIN_ARCHIVE_BYTES=2000000
# Full analysis: deadline and staged-download budget for paged Socrata datasets
DSP_FULL_DEADLINE_SECONDS=1800
DSP_SODA_FULL_MAX_MB=2048
# Connect timeout, and the longest a download may go without receiving data
DSP_DOWNLOAD_IDLE_SECONDS=30
DSP_LIVE_CACHE_HOURS=6
DSP_ADAPTER_TIMEOUT_SECONDS=20

# ---- Runs
# thread (default locally): the API process runs analyses. queue (default on Vercel): the API records jobs and
# `python -m app.worker` runs them (Docker: `docker compose --profile worker up`). Queue mode needs shared DATABASE_URL.
DSP_RUN_MODE=
DSP_WORKER_POLL_SECONDS=2
# Worker heartbeat / when a silent worker counts as offline / how long a queued job may wait / per-run stored file cap
DSP_WORKER_HEARTBEAT_SECONDS=5
DSP_WORKER_STALE_SECONDS=30
DSP_QUEUE_MAX_AGE_HOURS=24
# Vercel: run samples inside the site (default on when DATABASE_URL is set). Seconds one in-site run may take (keep under maxDuration)
DSP_INLINE_RUNS=
DSP_INLINE_BUDGET_SECONDS=240
DSP_MAX_ARTIFACT_MB=25

# ---- App
DSP_PORT=8000
DSP_GITHUB_REPO=
# 1 = run starter packs on this server (default in Docker/local; off on Vercel)
# DSP_PACK_RUNS=1
