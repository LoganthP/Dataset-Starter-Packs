{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build && rm -rf ../public && cp -r dist ../public",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,frontend/node_modules/**,frontend/src/**,public/**,packs/*/data/**,packs/*/outputs/**,scripts/**,docker/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
