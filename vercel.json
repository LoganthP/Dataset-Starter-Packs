{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,frontend/node_modules/**,frontend/src/**,packs/*/data/**,packs/*/outputs/**,scripts/**,docker/**}"
    }
  }
}
